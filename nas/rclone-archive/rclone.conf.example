# Redacted template of /volume1/scripts/rclone.conf on the NAS.
# The REAL file contains obscured (reversible) secrets and is NEVER committed.
# rclone "obscure" is NOT encryption — anyone with this file can recover the
# crypt password. Keep the real file chmod 600 and on the NAS only.
#
# Two remotes:
#   gcs    -> raw Google Cloud Storage bucket (Archive class, service-account auth)
#   secure -> crypt wrapper over gcs, doing client-side zero-knowledge encryption

[gcs]
type = google cloud storage
service_account_file = /volume1/scripts/gcs-sa.json
project_number = YOUR-GCP-PROJECT
bucket_policy_only = true
location = YOUR-REGION
storage_class = ARCHIVE

[secure]
type = crypt
remote = gcs:YOUR-BUCKET/backups
filename_encryption = standard
directory_name_encryption = true
password = <obscured — generated by `rclone obscure`; escrowed in 1Password>
# password2 (salt) — include ONLY if you set one; also escrowed in 1Password
