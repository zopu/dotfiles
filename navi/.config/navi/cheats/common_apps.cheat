% shell 

# New zsh session
zsh

% docker

# LazyDocker
lazydocker

% git, lazygit, lg

# LazyGit
lazygit

% git, worktree, tgs

# Git worktree session
tm-git-worktree-session.sh <branch>

% git, github, gh, dash

# gh-dash
gh dash

% git, github, gh, pr

# Open PR for current branch in browser
gh pr view --web

% dotfiles

# Neovim dotfiles
nvim ~/dotfiles/

% ToDo

# Todo
nvim ~/todo.txt

% Claude

# Claude
claude

% Navi

# Navi
zsh -c 'navi; exec zsh'

% Neovim, nv, nvim

# Neovim
nvim . && exec zsh

% Nushell

# Nushell
nu

% Yazi

# Yazi
yazi-tmux-wrapper.sh

% htop

# htop
htop
