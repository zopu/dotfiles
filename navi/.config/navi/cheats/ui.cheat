% sketchybar

# Reload sketchybar
sketchybar --reload

% karabiner, kanata
# Kickstart kanata daemon
sudo launchctl kickstart -k system/com.kanata

# Hard restart kanata daemon
sudo launchctl bootout system/com.kanata 2>/dev/null; sudo launchctl bootstrap system /Library/LaunchDaemons/com.kanata.plist
