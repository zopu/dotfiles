# Brewfile.core — Essential cross-platform dev tools
# Works on both macOS (Homebrew) and Linux (Linuxbrew)
# Used by bootstrap.sh on Linux; macOS uses the full Brewfile instead.
# Install with: brew bundle --file=Brewfile.core

# Taps
tap "jesseduffield/lazydocker"
tap "oven-sh/bun"
tap "sst/tap"

# Core CLI
brew "bat"
brew "curl"
brew "difftastic"
brew "dust"
brew "eza"
brew "fd"
brew "fzf"
brew "gcc"
brew "gh"
brew "git"
brew "git-delta"
brew "htop"
brew "hyperfine"
brew "jq"
brew "npm"
brew "ripgrep"
brew "shellcheck"
brew "shfmt"
brew "starship"
brew "stow"
brew "tlrc"           # Simplified man pages (maintained tldr client, provides `tldr`)
brew "tokei"
brew "tree"
brew "websocat"
brew "wget"
brew "yamllint"
brew "yq"             # YAML/JSON/XML processor (jq for YAML)
brew "zoxide"

# Newer CLI essentials
brew "ast-grep"       # Structural code search/lint/rewrite
brew "bottom"         # Process/system monitor (btm)
brew "glow"           # Render markdown in the terminal
brew "rclone"         # Rsync for cloud storage

# Dev tools
brew "carapace"
brew "direnv"
brew "helix"
brew "just"
brew "lazygit"
brew "navi"
brew "neovim"
brew "pre-commit"
brew "selene"
brew "stylua"
brew "thefuck"
brew "tmux"
brew "tpm"
brew "watchexec"
brew "yazi"

# Languages & runtimes
brew "deno"
brew "go"
brew "nvm"
brew "pipx"
brew "pnpm"
brew "poetry"
brew "python@3.13"
brew "uv"

# Specialized tap formulas
brew "jesseduffield/lazydocker/lazydocker"
brew "oven-sh/bun/bun"
brew "sst/tap/opencode"
